# Leave empty to use the Vite dev proxy (same-origin /api → backend).
VITE_API_BASE_URL=

# Optional: full backend origin when not using the proxy (must match CORS_ORIGIN on the server).
# VITE_API_BASE_URL=http://localhost:8000

# Dev only: proxy target when VITE_API_BASE_URL is empty (see vite.config.js).
# VITE_DEV_PROXY_TARGET=http://localhost:8000

